PAYLOAD_SECRET=change-me-to-a-long-random-string

# Supabase Postgres — use transaction pooler URL (port 6543) for serverless/Vercel
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CONTENT_PROVIDER=payload

# Shared dev password for admin users listed in data/payload/seed-users.json
PAYLOAD_SEED_PASSWORD=dev-admin-change-me

# Cloudflare R2 (S3-compatible uploads; public URLs for serving)
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
